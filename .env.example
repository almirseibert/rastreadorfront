# Copie para .env e troque TODAS as senhas. Este arquivo é só para o docker-compose.yml
# (topologia de referência / teste local); no EasyPanel as variáveis são configuradas em
# cada serviço, pela interface.

# Porta em que a pilha fica acessível na máquina local.
HTTP_PORT=8080

MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Usuário do Traccar: dono das tabelas tc_*.
DB_USER_TRACCAR=traccar
DB_PASSWORD_TRACCAR=troque-esta-senha-traccar

# Usuário do argos-api: acesso só ao banco `argos`, nenhum acesso às tabelas do Traccar.
DB_USER_ARGOS=argos
DB_PASSWORD_ARGOS=troque-esta-senha-argos

# Origens aceitas em requisições que alteram dados (vazio = não verifica; só para dev).
# Em produção: https://seu-dominio
ALLOWED_ORIGINS=
